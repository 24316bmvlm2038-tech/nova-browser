# Copy to .env.local and edit. Every value is optional — with an empty file the
# app uses DuckDuckGo for search and Ollama on its default port.
#
# Note: none of these are NEXT_PUBLIC_*. Search and Ollama are called from the
# Next.js server, never the browser, so keys stay out of the client bundle.

# ---------------------------------------------------------------- Ollama ----
# Where Ollama is listening.
OLLAMA_URL=http://127.0.0.1:11434

# Model used when you haven't picked one in Settings. Must be installed
# (`ollama pull llama3.2`). The app falls back to your first installed model.
OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------- Search ----
# Force a provider: duckduckgo | brave | serper | searxng
# Leave unset to auto-pick: a configured keyed provider if present, else DuckDuckGo.
# SEARCH_PROVIDER=duckduckgo

# Brave Search API — 2,000 queries/month free. https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=

# Serper.dev — Google results, 2,500 free credits. https://serper.dev
# Returns a dedicated shopping block, so it gives the best price results.
# SERPER_API_KEY=

# A SearXNG instance you run yourself. Needs `search.formats: [json]` in its settings.yml.
# SEARXNG_URL=http://localhost:8888

# ------------------------------------------------------- Live feeds ---------
# Reddit, Hacker News, Bluesky, Mastodon and Google News all work with no key.

# Which Mastodon instance to read trends from. Trends are per-instance, so this
# changes whose "trending" you see. mastodon.social is the largest.
# MASTODON_INSTANCE=https://mastodon.social

# Region and language for Google News and YouTube trending.
# NEWS_COUNTRY=US
# NEWS_LANGUAGE=en-US

# YouTube trending needs a key (free tier, Google Cloud console). Without it the
# YouTube source reports itself unavailable and is skipped.
# YOUTUBE_API_KEY=

# ------------------------------------------------------- Accounts ----------
# Where the local SQLite file lives (users, sessions, verification codes).
# DATABASE_PATH=.data/can-ai.db

# Public URL of the app. Used to build the Google redirect URI.
# APP_URL=http://localhost:3000

# --- Verification-code email ---
# Without these, codes are printed to the terminal running the app. They are
# real codes either way; SMTP just delivers them to a real inbox.
# For Gmail: create an App Password (2FA required), don't use your login password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=Can Ai <you@gmail.com>

# --- Google sign-in ---
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add this exact redirect URI:
#   http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# -------------------------------------------------- Image generation -------
# Local Stable Diffusion. Start the WebUI with --api and this is found
# automatically; set the URL only if it listens somewhere else.
# SD_WEBUI_URL=http://127.0.0.1:7860
# SD_STEPS=25
# SD_CFG=7
# SD_SAMPLER=DPM++ 2M

# ComfyUI instead of Automatic1111.
# COMFYUI_URL=http://127.0.0.1:8188

# Hosted fallback when the laptop can't run diffusion locally.
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL=black-forest-labs/flux-schnell

# Force one: automatic1111 | comfyui | replicate
# IMAGE_PROVIDER=
