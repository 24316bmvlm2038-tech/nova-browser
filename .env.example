# Copy to .env.local and edit. Every value is optional — with an empty file the
# app uses DuckDuckGo for search and Ollama on its default port.
#
# Note: none of these are NEXT_PUBLIC_*. Search and Ollama are called from the
# Next.js server, never the browser, so keys stay out of the client bundle.

# ---------------------------------------------------------------- Ollama ----
# Where Ollama is listening.
OLLAMA_URL=http://127.0.0.1:11434

# Model used when you haven't picked one in Settings. Must be installed
# (`ollama pull llama3.2`). The app falls back to your first installed model.
OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------- Search ----
# Force a provider: duckduckgo | brave | serper | searxng
# Leave unset to auto-pick: a configured keyed provider if present, else DuckDuckGo.
# SEARCH_PROVIDER=duckduckgo

# Brave Search API — 2,000 queries/month free. https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=

# Serper.dev — Google results, 2,500 free credits. https://serper.dev
# Returns a dedicated shopping block, so it gives the best price results.
# SERPER_API_KEY=

# A SearXNG instance you run yourself. Needs `search.formats: [json]` in its settings.yml.
# SEARXNG_URL=http://localhost:8888
