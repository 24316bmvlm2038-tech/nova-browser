# Ollama Configuration
# Set these environment variables to customize Ollama connection

# Ollama server URL (default: http://localhost:11434)
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434

# Default Ollama model to use (default: neural-chat)
# Popular options: neural-chat, mistral, llama2, dolphin-mixtral
# Install models with: ollama pull <model-name>
NEXT_PUBLIC_OLLAMA_MODEL=neural-chat
